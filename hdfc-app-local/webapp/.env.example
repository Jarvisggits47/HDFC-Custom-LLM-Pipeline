# Optional overrides — the app works with zero configuration.
# Copy to .env and uncomment the lines you want to change.

# ── Model selection ──────────────────────────────────────────────────────────
# Default: HuggingFaceTB/SmolLM2-360M-Instruct (fast CPU inference, ~360MB)
# Switch to a larger model for better quality — only requires changing this line.
# DEFAULT_MODEL=HuggingFaceTB/SmolLM2-360M-Instruct
# DEFAULT_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# DEFAULT_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# ── Embedding model ──────────────────────────────────────────────────────────
# EMBED_MODEL=BAAI/bge-small-en-v1.5

# ── Storage paths ────────────────────────────────────────────────────────────
# Writable paths for the SQLite DB and adapter/retriever artifacts.
# On Render/Railway set these to a persistent disk mount path.
# PIPELINE_DB_PATH=./pipeline.db
# RETRIEVER_DIR=./runs

# ── HuggingFace token ────────────────────────────────────────────────────────
# Only needed for gated models. Free models like SmolLM2 and Qwen don't need this.
# HF_TOKEN=hf_...

# ── Performance ──────────────────────────────────────────────────────────────
# Wall-clock timeout (seconds) for a single local generation.
# Raise if you see truncated responses on slow hardware.
# GENERATE_TIMEOUT_S=600

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Defaults to * (open, dev-only).
# Set to your frontend's exact origin in any non-local deployment.
# FRONTEND_ORIGIN=https://your-app.web.app,https://staging.your-app.web.app

# ── Retrieval ────────────────────────────────────────────────────────────────
# MIN_RETRIEVAL_SCORE=0.35
